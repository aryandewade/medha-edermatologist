# Medha E-Dermatologist Backend Configuration
# Kept securely on the backend server - never exposed to the frontend client

# AI Vision API Layer (Set ONE of the following API keys):
# 1. Google Gemini (Recommended - Gemini 2.0 / 1.5 Flash):
GEMINI_API_KEY=

# OR 2. OpenAI (GPT-4o-mini / GPT-4o):
OPENAI_API_KEY=

# Optional Provider Override ("gemini" or "openai"):
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-2.0-flash

# Existing Server Settings
CLASSES_PATH=../configs/classes.yaml
MAX_UPLOAD_MB=12
ALLOWED_ORIGINS=*
